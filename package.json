{
  "name": "dsh-long-context-budget",
  "version": "0.2.9",
  "type": "module",
  "description": "每会话上下文预算：超过预算触发比例时自动剪枝并压缩最早历史，输入框右侧滑杆分级选择，档位与触发比例随配置下发。 / Per-session context budget: prunes and compacts the oldest history at a configurable trigger ratio, with a tiered composer slider whose tiers and trigger ratio follow the host config.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "context-budget",
    "token-budget",
    "compaction",
    "context-compression",
    "conversation-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASCII-58/long-context-budget.git"
  },
  "homepage": "https://github.com/ASCII-58/long-context-budget#readme",
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "tiers.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
