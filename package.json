{
  "name": "@local/dsh-long-context-budget",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "每会话上下文预算：超预算 70% 时先剪枝、再压缩最早历史；输入框右侧按 min(128K,(窗口−256K)×0.5) 分级选择。 / Per-session context budget: prunes then compacts the oldest history at 70% of budget, with a tiered slider on the composer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "tiers.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "4.6.6"
  }
}
